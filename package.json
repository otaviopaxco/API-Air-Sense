{
  "name": "esp32-airsense-api",
  "version": "1.0.0",
  "description": "API Node.js para recepção, validação, agregação e disponibilização de dados de sensores ESP32 (CO2, CH4, VOC, Temperatura, Umidade) usando Firebase Realtime Database.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "firebase-admin": "^12.3.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "node-cron": "^3.0.3",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
