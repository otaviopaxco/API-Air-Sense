# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Firebase Admin SDK ---
# Cole aqui o conteúdo do JSON da service account (uma linha só, com \n escapados)
# Gere em: Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...": "..."}
FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com

# --- Segurança ---
# Cada ESP32 tem sua PRÓPRIA chave, gerada ao provisionar via POST /api/admin/dispositivos
# (não configure uma chave fixa aqui para isso — é só para o modo de teste abaixo).
# Opcional: chave mestra válida para qualquer dispositivo, útil só em testes/desenvolvimento.
# Deixe em branco em produção.
ESP32_MASTER_KEY=

# Chave usada para provisionar/gerenciar dispositivos (POST /api/admin/dispositivos)
ADMIN_API_KEY=troque-esta-chave-de-administrador

# Chave que o app (Expo) deve enviar no header X-App-Key
APP_API_KEY=troque-esta-chave-para-o-app

# --- Retenção de dados ---
# Após quantos dias apagar as médias horárias (leituras_horarias)
HOURLY_RETENTION_DAYS=7

# Segundos sem receber leitura para considerar um dispositivo "offline" no /api/resumo
OFFLINE_THRESHOLD_SECONDS=120
